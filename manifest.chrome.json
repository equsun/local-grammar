{
  "manifest_version": 3,
  "name": "Local Grammar",
  "version": "1.1.0",
  "description": "Grammar fixes for highlighted text, powered by your local Ollama models.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Grammar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup.html"
  },
  "commands": {
    "check-grammar": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Check grammar of the selected text"
    }
  }
}
